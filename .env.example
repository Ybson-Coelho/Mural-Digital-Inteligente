# Ambiente (production em hospedagem, development local)
NODE_ENV=development

# Portas (usadas localmente e no Docker)
PORT=3001
FRONTEND_PORT=5500

# Chave secreta da sessao (minimo 32 caracteres)
SESSION_SECRET=coloque_uma_chave_secreta_com_mais_de_32_caracteres_aqui

# Endereco do front aceito no CORS (no Render, use a URL da Vercel: https://seu-front.vercel.app)
FRONTEND_URL=http://localhost:5500

# Endereco do back
BACKEND_URL=http://localhost:3001

# Caminhos do banco SQLite e da pasta de uploads (no Render pode deixar padrao ou usar disco)
DB_PATH=/app/dados/viva_ciencia.sqlite
UPLOAD_DIR=/app/uploads

# Administrador inicial criado automaticamente no primeiro inicio
ADMIN_NOME=Samuel Vieira de Souza
ADMIN_EMAIL=samuel.souza7@estudante.ifto.edu.br
ADMIN_MATRICULA=202512940007
ADMIN_SENHA=coloque_uma_senha_forte_com_no_minimo_8_caracteres
